id {
  package: "ai.tar2"
  name: "check_board_visibility_skill_v4"
}
display_name: "Search Board Visibility v4"
vendor {
  display_name: "TAR-2"
}
documentation {
  description: "Uses only the three permitted wrist cameras, measured arm joints/controller state, wrist force, and robot-mounted TF to produce a deterministic IVM survey view. The workflow acquires and centers the board with J1, aligns its physical long edge to within 2 degrees with direct J6 after two fresh signed estimates agree, then levels the center-camera optical axis straight down and frames the survey through the J2-J4 Cartesian path. J1 learns horizontal image response from each fresh post-motion frame so later centering corrections converge faster. Calibrated gripper silhouettes are excluded before segmentation and also become a quantitative terminal constraint: the protected convex board/component envelope must have zero mask overlap and at least 20 pixels of separation. During leveling and post-level framing, J2-J4 moves opposite the measured mask-escape direction; the next fresh frame validates the polarity and reverses it if overlap grows or clearance shrinks. Once mask-clear, ordinary vertical recentering is suppressed unless physical/context edges are clipped, so the policy does not move the board back behind the gripper. Survey scale is held between 26 and 36 percent of the image with bounded approach/backoff. Completion requires two consecutive fresh center-camera frames with the full board and component context visible, logo identity present, rectangularity at least 0.72, long-axis ratio at least 1.15, orientation error at most 2 degrees, top-down TF, zero protected-envelope mask overlap, and required gripper clearance. Side cameras aid acquisition only. Cartesian IK drift in J1/J6 returns to visual correction. Direct-joint transactions independently validate measured-joint freshness and explicit mode changes. Legacy cumulative/start-relative motion-envelope parameters remain accepted for node compatibility but do not terminate the search; native controller limits remain active. Every move requires fresh wrist force, aborts/reverses on configured force limits, verifies measured completion, honors cancellation, and remains within the 90-second workflow deadline. No task-board, port, module, cable, Gazebo, or scoring ground-truth pose is read."
}
options {
  supports_cancellation: true
  python_config {
    skill_module: "aic_perception.check_board_visibility_skill"
    proto_module: "aic_perception.check_board_visibility_skill_pb2"
    create_skill: "aic_perception.check_board_visibility_skill.CheckBoardVisibilitySkill"
  }
}
dependencies {
}
parameter {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillParams"
  default_value: {
    type_url: "type.googleapis.com/ai.tar2.CheckBoardVisibilitySkillParams"
  }
}
return_type {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillResult"
}
