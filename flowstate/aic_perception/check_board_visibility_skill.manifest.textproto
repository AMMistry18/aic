id {
  package: "ai.tar2"
  name: "check_board_visibility_skill_v4"
}
display_name: "Search Board Visibility v4"
vendor {
  display_name: "TAR-2"
}
documentation {
  description: "Uses only the three permitted wrist cameras, measured arm joints/controller state, wrist force, CameraInfo, and robot-mounted TF. For the STAGED_SFP_MODULE target this is perception-only: Stage 1 optionally moves to expose the board's asymmetric purple insignia, then Stage 2 estimates the full board pose by planar PnP of the insignia (clip-proof, no plate-outline dependency) and computes one board-relative TCP survey pose that frames the whole board when reachable and the SFP/SC module region at minimum in all three calibrated cameras. It publishes that pose as result.survey_pose (a base_link intrinsic_proto.Pose) for a downstream Move Robot skill and does not execute the survey move itself; done=true means a valid pose was published. Every PnP and projection uses the TF queried at its camera's image time, never latest TF. NIC_SFP_DESTINATION and SC_DESTINATION_PORT retain the legacy feedback-driven board-visibility behavior. Missing calibration, unavailable/stale TF, no exposed insignia, or no all-camera survey pose returns success=true and done=false. No task-board, port, module, cable, Gazebo, or scoring ground-truth pose is read."
}
options {
  supports_cancellation: true
  python_config {
    skill_module: "aic_perception.check_board_visibility_skill"
    proto_module: "aic_perception.check_board_visibility_skill_pb2"
    create_skill: "aic_perception.check_board_visibility_skill.CheckBoardVisibilitySkill"
  }
}
dependencies {
}
parameter {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillParams"
  default_value: {
    type_url: "type.googleapis.com/ai.tar2.CheckBoardVisibilitySkillParams"
  }
}
return_type {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillResult"
}
