id {
  package: "ai.tar2"
  name: "check_board_visibility_skill_v4"
}
display_name: "Search Board Visibility v4"
vendor {
  display_name: "TAR-2"
}
documentation {
  description: "Uses only the three permitted wrist cameras, measured arm joints/controller state, wrist force, CameraInfo, and robot-mounted TF to produce a synchronized loose-SFP survey view. Stage 1 obtains a complete unobstructed purple logo and board outline. Stage 2 estimates board pose from calibrated intrinsics, exact image-timestamp TF, and CAD geometry, then plans one board-relative TCP survey pose. Simulator CameraInfo/image messages may be named only by that camera's fixed sensor_link or optical frame; projection always uses the corresponding allowlisted optical TF. A conservative full gripper mask is a terminal exclusion: every projected loose-SFP envelope must be wholly inside every physical image, have positive boundary margin, zero mask overlap, at least 32 pixels mask clearance, and enough scale. Completion requires two fresh triplets within 50 ms. Every PnP and every projection uses the TF queried at its camera's image time, never latest TF. Missing calibration, unavailable/stale TF, unsafe workspace/path sampling, or any one-camera failure returns success=true and done=false without unsafe motion. At most one board-normal retreat may precede lateral transit. Search duration is bounded to 60 seconds. No task-board, port, module, cable, Gazebo, or scoring ground-truth pose is read."
}
options {
  supports_cancellation: true
  python_config {
    skill_module: "aic_perception.check_board_visibility_skill"
    proto_module: "aic_perception.check_board_visibility_skill_pb2"
    create_skill: "aic_perception.check_board_visibility_skill.CheckBoardVisibilitySkill"
  }
}
dependencies {
}
parameter {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillParams"
  default_value: {
    type_url: "type.googleapis.com/ai.tar2.CheckBoardVisibilitySkillParams"
  }
}
return_type {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillResult"
}
