id {
  package: "ai.tar2"
  name: "check_board_visibility_skill_v4"
}
display_name: "Search Board Visibility v4"
vendor {
  display_name: "TAR-2"
}
documentation {
  description: "Uses only the three permitted wrist cameras, measured arm joints/controller state, wrist force, and robot-mounted TF to produce a synchronized IVM survey view. The workflow centers with J1, aligns the board's physical long edge to within 2 degrees with direct J6 after two fresh signed estimates agree, then levels the center-camera optical axis straight down and frames through J2-J4. J1 learns horizontal image response from each fresh post-motion frame for faster convergence. Calibrated gripper silhouettes are excluded before segmentation and become quantitative constraints in every camera. The center protected board/component envelope must have zero overlap and at least 20 pixels of mask separation; each side camera must independently retain board/logo evidence, at least 8 percent board area, rectangularity at least 0.55, component context, zero overlap, and at least 12 pixels of separation. Once the center view is strict, the worst side-camera failure drives a smaller J2-J4 translation through that camera's calibrated image-plane TF. Mask-escape polarity is learned separately per camera and reverses when the next fresh frame shows growing overlap or shrinking clearance. Center survey scale remains between 26 and 36 percent with bounded approach/backoff. Completion requires two consecutive synchronized snapshots: the center must retain full context, logo identity, rectangularity at least 0.72, long-axis ratio at least 1.15, orientation error at most 2 degrees, top-down TF, and its mask clearance, while both side views simultaneously pass their context and gripper-clear predicates. No side camera can complete the policy alone. Cartesian IK drift in J1/J6 returns to visual correction. Direct-joint transactions independently validate measured-joint freshness and explicit mode changes. Legacy cumulative/start-relative motion-envelope parameters remain accepted for node compatibility but do not terminate the search; native controller limits remain active. Every move requires fresh wrist force, aborts/reverses on configured force limits, verifies measured completion, honors cancellation, and remains within the 90-second deadline. No task-board, port, module, cable, Gazebo, or scoring ground-truth pose is read."
}
options {
  supports_cancellation: true
  python_config {
    skill_module: "aic_perception.check_board_visibility_skill"
    proto_module: "aic_perception.check_board_visibility_skill_pb2"
    create_skill: "aic_perception.check_board_visibility_skill.CheckBoardVisibilitySkill"
  }
}
dependencies {
}
parameter {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillParams"
  default_value: {
    type_url: "type.googleapis.com/ai.tar2.CheckBoardVisibilitySkillParams"
  }
}
return_type {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillResult"
}
