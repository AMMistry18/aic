id {
  package: "ai.tar2"
  name: "check_board_visibility_skill_v4"
}
display_name: "Search Board Visibility v4"
vendor {
  display_name: "TAR-2"
}
documentation {
  description: "Uses the three permitted wrist-camera images, measured /joint_states arm angles, controller state, wrist force, and robot-mounted TF frames to find one stable camera view containing the full task board plus a padded NIC/SC component envelope. The fixed feedback workflow first centers the center-camera board mask with a bounded shoulder-pan-equivalent J1 Cartesian yaw arc, then applies monotonic J2 standoff, J3 vertical clearance, and bounded J4 optical-axis roll. Live-calibrated J1 image polarity, cumulative wrong-way detection, fresh-frame confirmation, mask-identity geometry locks, rollback camera validation, one-reversal guards, and bounded J2/J3 recovery ladders prevent premature phase changes and yaw/roll limit cycles. Every move retains measured settling, start-relative and cumulative workspace limits, force-triggered reversal, and a bounded deadline. It never reads task-board, port, module, cable, Gazebo, or scoring ground-truth poses."
}
options {
  supports_cancellation: true
  python_config {
    skill_module: "aic_perception.check_board_visibility_skill"
    proto_module: "aic_perception.check_board_visibility_skill_pb2"
    create_skill: "aic_perception.check_board_visibility_skill.CheckBoardVisibilitySkill"
  }
}
dependencies {
}
parameter {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillParams"
  default_value: {
    type_url: "type.googleapis.com/ai.tar2.CheckBoardVisibilitySkillParams"
  }
}
return_type {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillResult"
}
