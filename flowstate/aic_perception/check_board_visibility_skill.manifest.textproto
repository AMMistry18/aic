id {
  package: "ai.tar2"
  name: "check_board_visibility_skill_v4"
}
display_name: "Search Board Visibility v4"
vendor {
  display_name: "TAR-2"
}
documentation {
    description: "Uses the three permitted wrist-camera images, measured /joint_states arm angles, controller state, wrist force, and robot-mounted TF frames to find one stable camera view containing the full task board plus a padded NIC/SC component envelope. Exact calibrated per-camera gripper silhouettes from the board-search perception branch are excluded before component selection, so the robot cannot be selected as the board. The deterministic insignia-anchored workflow detects the board's magenta logo (HSV H 135-165, validated against sim frames) as a unique fiducial: purple presence proves the board is in view, the dark component touching it is the board by construction, and the logo region is filled into the mask so it can never flicker the segmentation. The policy levels the TCP/tool axis straight down in bounded pitch stages, sweeps and centers with direct measured shoulder_pan_joint (J1) commands that preserve the other five joints, then aligns the broad plate core's physical long edge through bounded direct wrist_3_joint (J6) commands. A moderate long-axis ratio of 1.15 is accepted only after two fresh frames agree on its signed orientation, allowing stable low-perspective views while rejecting one-frame edge flips. All three permitted images remain available for acquisition and steering, but completion requires two fresh center-camera frames that satisfy the stricter IVM survey predicate: full plate and logo, centered board, aligned long edge, sufficient rectangularity and component context, usable scale, and no gripper-mask contact. When J6 is ambiguous or unavailable, measured horizontal error falls back to J1 or a bounded joints 2-4 optical-axis zoom-out; exhausted zoom uses larger base +Z clearance steps. Camera/force arrival races and controller handoff may wait up to the configured sensor/TF budget for a genuinely fresh wrench sample, while stale force during motion still aborts. Expected search and sensor failures return success=false instead of throwing so a serial Flowstate process can always Switch To Default Controller before validating the result or starting Move Robot. Every move retains measured settling, start-relative and cumulative workspace limits, force-triggered abort, and a bounded 150-second default search deadline. It never reads task-board, port, module, cable, Gazebo, or scoring ground-truth poses."
}
options {
  supports_cancellation: true
  python_config {
    skill_module: "aic_perception.check_board_visibility_skill"
    proto_module: "aic_perception.check_board_visibility_skill_pb2"
    create_skill: "aic_perception.check_board_visibility_skill.CheckBoardVisibilitySkill"
  }
}
dependencies {
}
parameter {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillParams"
  default_value: {
    type_url: "type.googleapis.com/ai.tar2.CheckBoardVisibilitySkillParams"
  }
}
return_type {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillResult"
}
