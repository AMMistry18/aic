id {
  package: "ai.tar2"
  name: "check_board_visibility_skill_v4"
}
display_name: "Search Board Visibility v4"
vendor {
  display_name: "TAR-2"
}
documentation {
  description: "Uses permitted wrist-camera images, measured /joint_states arm angles, controller state, wrist force, and robot-mounted TF frames to search until the full task board and a padded NIC/SC component envelope are visible. Image feedback hill-climbs the shoulder-pan-equivalent base-Z TCP arc against all three camera masks, prioritizing camera count and worst-camera board area; a worsening probe tests the opposite yaw. The arc rotates TCP position and orientation together through the accepted Cartesian controller and does not require a joint-target-mode switch. Only after three-camera horizontal coverage succeeds, or after both safe yaw directions fail at one height, may it raise the TCP; an escape height step is immediately followed by another yaw optimization. Every move retains measured settling, workspace/travel limits, force-triggered reversal, and a bounded deadline. It never reads task-board, port, module, cable, Gazebo, or scoring ground-truth poses."
}
options {
  supports_cancellation: true
  python_config {
    skill_module: "aic_perception.check_board_visibility_skill"
    proto_module: "aic_perception.check_board_visibility_skill_pb2"
    create_skill: "aic_perception.check_board_visibility_skill.CheckBoardVisibilitySkill"
  }
}
dependencies {
}
parameter {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillParams"
  default_value: {
    type_url: "type.googleapis.com/ai.tar2.CheckBoardVisibilitySkillParams"
  }
}
return_type {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillResult"
}
