id {
  package: "ai.tar2"
  name: "check_board_visibility_skill_v4"
}
display_name: "Search Board Visibility v4"
vendor {
  display_name: "TAR-2"
}
documentation {
  description: "Uses the three wrist cameras, measured joints/controller state, wrist force, and robot-mounted TF to frame an IVM component survey. The survey_target dropdown provides STAGED_SFP_MODULE, NIC_SFP_DESTINATION, and SC_DESTINATION_PORT; UNSPECIFIED preserves legacy board-overview behavior. Explicit modes derive a board-relative component ROI and steer, mask, and complete against that ROI rather than requiring the whole plate. Completion requires the selected ROI to pass context and calibrated gripper-clearance predicates in all three cameras for two synchronized snapshots. J1 centers the view, direct J6 aligns the board long axis to within 2 degrees after two fresh signed estimates agree, and J2-J4 place the center camera at a 32 degree survey tilt within 2 degrees. Fresh image feedback remains authoritative after Cartesian IK redistribution. Every motion requires fresh wrist force, reverses at the configured force limit, verifies measured completion, honors cancellation and the search deadline, and retains native controller limits. Direct-joint moves validate joint freshness and controller mode. On every normal result the skill stops its command stream at measured state and releases its invocation lock; Flowstate must then run Switch To Default Controller before another arm skill. No task-object or scoring ground-truth pose is read."
}
options {
  supports_cancellation: true
  python_config {
    skill_module: "aic_perception.check_board_visibility_skill"
    proto_module: "aic_perception.check_board_visibility_skill_pb2"
    create_skill: "aic_perception.check_board_visibility_skill.CheckBoardVisibilitySkill"
  }
}
dependencies {
}
parameter {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillParams"
  default_value: {
    type_url: "type.googleapis.com/ai.tar2.CheckBoardVisibilitySkillParams"
  }
}
return_type {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillResult"
}
