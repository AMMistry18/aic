id {
  package: "ai.tar2"
  name: "check_board_visibility_skill_v4"
}
display_name: "Search Board Visibility v4"
vendor {
  display_name: "TAR-2"
}
documentation {
  description: "Uses the three permitted wrist-camera images, measured /joint_states arm angles, controller state, wrist force, and robot-mounted TF frames to find a complete top view of the task board. Calibrated gripper silhouettes are excluded before board selection; mask contact stays diagnostic and cannot veto a complete board boundary. The deterministic workflow first acquires and centers the board with shoulder_pan_joint (J1), then aligns the physical long board edge to within 2 degrees using direct wrist_3_joint (J6) motion after two fresh frames agree on the signed estimate at a long-axis ratio of at least 1.15. Fine J6 commands may be as small as about 1 degree, avoiding the old 8.6-degree minimum-step overshoot. Only after J6 alignment does it level the center-camera optical axis straight down and increase standoff through the joints 2-4 Cartesian path. During leveling and post-level framing, signed center-camera vertical error drives a bidirectional J2-4 camera-plane correction before optical backoff; each fresh frame validates the command polarity and reverses it if the board moved farther toward the same edge. Cartesian IK drift in J1 or J6 returns to visual centering/alignment instead of terminating the search. Side cameras aid acquisition but never define success. Completion is immediate on the first fresh center-camera frame whose full-board mask passes after J6 alignment and top-down leveling; it does not require the logo, extra IVM context, gripper-mask noncontact, or another long-axis estimate on the terminal frame. Direct-joint transactions independently validate measured joint freshness and explicit controller mode changes, so an aging asynchronous mode timestamp cannot cancel a healthy joint profile. Machine-readable failure reasons select controller fallbacks without parsing log strings. Legacy cumulative and start-relative motion-envelope parameters remain accepted for node compatibility but no longer terminate viewpoint search; the controller's native joint and velocity limits remain active. Every commanded move still requires fresh wrist-force feedback, aborts and reverses on the configured force limit, verifies measured completion, honors cancellation, and is bounded by a 90-second default workflow deadline. It never reads task-board, port, module, cable, Gazebo, or scoring ground-truth poses."
}
options {
  supports_cancellation: true
  python_config {
    skill_module: "aic_perception.check_board_visibility_skill"
    proto_module: "aic_perception.check_board_visibility_skill_pb2"
    create_skill: "aic_perception.check_board_visibility_skill.CheckBoardVisibilitySkill"
  }
}
dependencies {
}
parameter {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillParams"
  default_value: {
    type_url: "type.googleapis.com/ai.tar2.CheckBoardVisibilitySkillParams"
  }
}
return_type {
  message_full_name: "ai.tar2.CheckBoardVisibilitySkillResult"
}
