<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aic_perception</name>
  <version>0.1.0</version>
  <description>Guarded camera-driven board search skill for AIC Flowstate.</description>
  <maintainer email="tar2@example.invalid">TAR-2</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>intrinsic_sdk_cmake</buildtool_depend>
  <buildtool_depend>protobuf</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>aic_control_interfaces</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros_py</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
