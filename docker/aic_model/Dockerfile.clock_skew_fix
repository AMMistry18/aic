ARG BASE_IMAGE=my-solution:pre-clock-skew-fix
FROM ${BASE_IMAGE}

# Apply the complete policy-code overlay. Starting from the preserved model
# image keeps dependency and model-weight layers cached while ensuring newly
# added runtime modules are not silently omitted from a thin build.
COPY docker/aic_model/v50_overlay/aic_model /tmp/aic_model_overlay

RUN SITE_PACKAGES="$(.pixi/envs/default/bin/python -c 'import site; print(site.getsitepackages()[0])')" && \
    cp /tmp/aic_model_overlay/*.py /ws_aic/src/aic/aic_model/aic_model/ && \
    cp /tmp/aic_model_overlay/*.py "$SITE_PACKAGES/aic_model/" && \
    .pixi/envs/default/bin/python -m py_compile \
      /ws_aic/src/aic/aic_model/aic_model/*.py \
      "$SITE_PACKAGES"/aic_model/*.py && \
    grep -q 'age = max(0.0, now - estimate_stamp)' \
      /ws_aic/src/aic/aic_model/aic_model/sfp_plug_pose.py && \
    grep -q 'run_sc_insertion' \
      /ws_aic/src/aic/aic_model/aic_model/RLInsert.py && \
    grep -q 'def run_sc_insertion' \
      /ws_aic/src/aic/aic_model/aic_model/sc_controller.py
