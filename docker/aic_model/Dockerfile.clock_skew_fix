ARG BASE_IMAGE=my-solution:pre-insert-diagnostics
FROM ${BASE_IMAGE}

# Patch only the policy/controller/estimator files changed after the preserved model image.
# This keeps ROS, Pixi, Python packages, and model weights in the cached base.
COPY docker/aic_model/v50_overlay/aic_model/sfp_plug_pose.py /tmp/sfp_plug_pose.py
COPY docker/aic_model/v50_overlay/aic_model/RLInsert.py /tmp/RLInsert.py
COPY docker/aic_model/v50_overlay/aic_model/v50_controller.py /tmp/v50_controller.py

RUN SITE_PACKAGES="$(.pixi/envs/default/bin/python -c 'import site; print(site.getsitepackages()[0])')" && \
    cp /tmp/sfp_plug_pose.py /ws_aic/src/aic/aic_model/aic_model/sfp_plug_pose.py && \
    cp /tmp/sfp_plug_pose.py "$SITE_PACKAGES/aic_model/sfp_plug_pose.py" && \
    cp /tmp/RLInsert.py /ws_aic/src/aic/aic_model/aic_model/RLInsert.py && \
    cp /tmp/RLInsert.py "$SITE_PACKAGES/aic_model/RLInsert.py" && \
    cp /tmp/v50_controller.py /ws_aic/src/aic/aic_model/aic_model/v50_controller.py && \
    cp /tmp/v50_controller.py "$SITE_PACKAGES/aic_model/v50_controller.py" && \
    .pixi/envs/default/bin/python -m py_compile \
      /ws_aic/src/aic/aic_model/aic_model/sfp_plug_pose.py \
      "$SITE_PACKAGES/aic_model/sfp_plug_pose.py" \
      /ws_aic/src/aic/aic_model/aic_model/RLInsert.py \
      "$SITE_PACKAGES/aic_model/RLInsert.py" \
      /ws_aic/src/aic/aic_model/aic_model/v50_controller.py \
      "$SITE_PACKAGES/aic_model/v50_controller.py" && \
    grep -q 'age = max(0.0, now - estimate_stamp)' \
      /ws_aic/src/aic/aic_model/aic_model/sfp_plug_pose.py && \
    grep -q 'max_reprojection_error_px: float = 6.0' \
      /ws_aic/src/aic/aic_model/aic_model/sfp_plug_pose.py && \
    grep -q 'max_reprojection_error_px: float = 6.0' \
      "$SITE_PACKAGES/aic_model/sfp_plug_pose.py" && \
    grep -q 'MAX_SELECT_REPROJ_PX' \
      /ws_aic/src/aic/aic_model/aic_model/RLInsert.py && \
    grep -q 'MAX_SELECT_REPROJ_PX' \
      "$SITE_PACKAGES/aic_model/RLInsert.py" && \
    grep -q 'SEAT_WRENCH' \
      /ws_aic/src/aic/aic_model/aic_model/v50_controller.py && \
    grep -q 'SEAT_WRENCH' \
      "$SITE_PACKAGES/aic_model/v50_controller.py"
