ARG BASE_IMAGE=my-solution:student-flowstate-v49-wedge-only-visual
FROM ${BASE_IMAGE}

# v50 is deliberately based on the exact live v49 runtime, not the materially
# different checkout RLInsert.py.  Refuse to build if either runtime copy drifted.
RUN test "$(sha256sum /ws_aic/src/aic/aic_model/aic_model/RLInsert.py | cut -d' ' -f1)" = \
      "d88c8c764df508578451d498aeaccbd5490b204799868413bf993c78b55c8365" && \
    test "$(sha256sum /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/RLInsert.py | cut -d' ' -f1)" = \
      "d88c8c764df508578451d498aeaccbd5490b204799868413bf993c78b55c8365" && \
    test "$(sha256sum /ws_aic/src/aic/aic_model/aic_model/aic_model.py | cut -d' ' -f1)" = \
      "aaee29b9f38cfac2abe9e51b22da2811559160762e16efd479eafeb828bea0c4" && \
    test "$(sha256sum /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/aic_model.py | cut -d' ' -f1)" = \
      "aaee29b9f38cfac2abe9e51b22da2811559160762e16efd479eafeb828bea0c4"

COPY aic_model/aic_model/v50_controller.py /tmp/v50_controller.py
COPY aic_model/aic_model/sfp_plug_pose.py /tmp/sfp_plug_pose.py
COPY aic_model/aic_model/sfp_plug_pose_geometry.py /tmp/sfp_plug_pose_geometry.py
COPY aic_example_policies/aic_example_policies/ros/weights/best_sfp_plug_pose.pt \
     /tmp/best_sfp_plug_pose.pt
COPY docker/aic_model/patch_v49_plug_relative_v50.py \
     /tmp/patch_v49_plug_relative_v50.py

RUN install -m 0644 /tmp/v50_controller.py \
      /ws_aic/src/aic/aic_model/aic_model/v50_controller.py && \
    install -m 0644 /tmp/v50_controller.py \
      /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/v50_controller.py && \
    install -m 0644 /tmp/sfp_plug_pose.py \
      /ws_aic/src/aic/aic_model/aic_model/sfp_plug_pose.py && \
    install -m 0644 /tmp/sfp_plug_pose.py \
      /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/sfp_plug_pose.py && \
    install -m 0644 /tmp/sfp_plug_pose_geometry.py \
      /ws_aic/src/aic/aic_model/aic_model/sfp_plug_pose_geometry.py && \
    install -m 0644 /tmp/sfp_plug_pose_geometry.py \
      /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/sfp_plug_pose_geometry.py && \
    install -m 0644 /tmp/best_sfp_plug_pose.pt \
      /ws_aic/src/aic/aic_example_policies/aic_example_policies/ros/weights/best_sfp_plug_pose.pt && \
    /ws_aic/src/aic/.pixi/envs/default/bin/python \
      /tmp/patch_v49_plug_relative_v50.py \
      /ws_aic/src/aic/aic_model/aic_model/RLInsert.py \
      /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/RLInsert.py \
      /ws_aic/src/aic/aic_model/aic_model/aic_model.py \
      /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/aic_model.py && \
    /ws_aic/src/aic/.pixi/envs/default/bin/python -m py_compile \
      /ws_aic/src/aic/aic_model/aic_model/RLInsert.py \
      /ws_aic/src/aic/aic_model/aic_model/aic_model.py \
      /ws_aic/src/aic/aic_model/aic_model/v50_controller.py \
      /ws_aic/src/aic/aic_model/aic_model/sfp_plug_pose.py \
      /ws_aic/src/aic/aic_model/aic_model/sfp_plug_pose_geometry.py \
      /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/RLInsert.py \
      /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/aic_model.py \
      /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/v50_controller.py && \
    grep -Fq "return run_v50_script(" \
      /ws_aic/src/aic/aic_model/aic_model/RLInsert.py && \
    grep -Fq "no fixed-bias fallback is allowed" \
      /ws_aic/src/aic/aic_model/aic_model/v50_controller.py && \
    grep -Fq "Cable insertion failed: no correct-port event" \
      /ws_aic/src/aic/aic_model/aic_model/aic_model.py

# Release defaults: 700 s hard wall deadline, visual contrast is the first
# wedge rescue, one bounded 6mm lift/re-perception cycle, and no RL actor path.
ENV AIC_SFP_PLUG_POSE_WEIGHTS=/ws_aic/src/aic/aic_example_policies/aic_example_policies/ros/weights/best_sfp_plug_pose.pt
ENV RL_INSERT_ACTION_TIME_BUDGET_S=700
ENV RL_INSERT_VISUAL_GAP_WEDGE_ENABLE=1
ENV RL_INSERT_VISUAL_GAP_DEBUG=1
ENV RL_INSERT_V50_TARGET_FORCE_N=10.0
ENV RL_INSERT_V50_SEAT_FORCE_CAP_N=12.0
ENV RL_INSERT_FORCE_ABORT_N=18.0
ENV RL_INSERT_V50_LIFT_DISTANCE_M=0.006
ENV RL_INSERT_V50_MAX_VISUAL_RESCUES=1
ENV RL_INSERT_V50_MAX_LIFT_RECOVERIES=1
ENV RL_INSERT_CONTROL_MODE=script
ENV RL_INSERT_SCRIPT_BIAS_X_M=0
ENV RL_INSERT_SCRIPT_BIAS_Y_M=0
ENV RL_INSERT_SCRIPT_BIAS_RX_RAD=0
ENV RL_INSERT_MODEL=""
ENV RL_INSERT_SEAT_MODEL=""
