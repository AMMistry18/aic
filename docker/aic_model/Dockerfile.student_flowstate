ARG BASE_IMAGE=my-solution:v8
FROM ${BASE_IMAGE}

# Reuse the validated AMD64 ROS/Pixi environment and replace only the policy
# implementation and immutable student artifact.  RLInsert is now self-contained
# (it does its own perception); the only aic_example_policies dependency is the
# raw YOLO wrapper perception_core.py.  best.pt / best_sc_pose.pt come from the
# base image's weights dir next to perception_core.
COPY aic_example_policies/aic_example_policies/ros/perception_core.py /ws_aic/src/aic/aic_example_policies/aic_example_policies/ros/perception_core.py
COPY aic_example_policies/aic_example_policies/ros/perception_core.py /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_example_policies/ros/perception_core.py
COPY aic_model/aic_model/RLInsert.py /ws_aic/src/aic/aic_model/aic_model/RLInsert.py
COPY aic_model/aic_model/board_search.py /ws_aic/src/aic/aic_model/aic_model/board_search.py
COPY aic_model/aic_model/rl_insert_contract.py /ws_aic/src/aic/aic_model/aic_model/rl_insert_contract.py
COPY aic_model/aic_model/RLInsert.py /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/RLInsert.py
COPY aic_model/aic_model/board_search.py /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/board_search.py
COPY aic_model/aic_model/rl_insert_contract.py /ws_aic/src/aic/.pixi/envs/default/lib/python3.12/site-packages/aic_model/rl_insert_contract.py

COPY models/final_insert_sfp_flowstate_v1.ts /models/final_insert_sfp_flowstate_v1.ts
COPY models/final_insert_sfp_flowstate_v1.ts.contract.json /models/final_insert_sfp_flowstate_v1.ts.contract.json

ENV RL_INSERT_MODEL=/models/final_insert_sfp_flowstate_v1.ts
ENV RL_INSERT_WRENCH_MODE=baseline
# script = pure-geometry align-then-progressive-descent, NO RL (align-first test
# bed). Set back to rl / guided to run the learned / scripted-lead policies.
ENV RL_INSERT_CONTROL_MODE=script
# ``Task.id == board_search_only`` runs only the board-framing pre-step.  Keep
# the optional prepend mode off so ordinary task IDs execute the v35 path.
ENV RL_INSERT_BOARD_SEARCH=0
ENV RL_INSERT_BOARD_SEARCH_ONLY_TASK_ID=board_search_only
# One-shot grasp-calibration dump at handoff: logs TCP + ground-truth tip frame
# so SFP_TIP_IN_TCP_QUAT can be recalibrated to the real grasp. Set 0 to disable.
ENV RL_INSERT_CALIB_DUMP=1
ENV RL_INSERT_GUIDED_CONTACT_DEPTH_M=-0.008
ENV RL_INSERT_GUIDED_CONTACT_MAX_LEAD_M=0.020
ENV RL_INSERT_SAFETY_MAX_LATERAL_M=0.006
ENV RL_INSERT_SAFETY_MAX_ROTATION_RAD=0.20
ENV RL_INSERT_FORCE_ABORT_N=18.0
ENV AIC_SFP_TARGET_MODE=nearest_tip
ENV RL_INSERT_PREPOSITION=1
ENV RL_INSERT_HANDOFF_GAP_M=0.026
ENV RL_INSERT_HANDOFF_LATERAL_SIGMA_M=0
ENV RL_INSERT_HANDOFF_AXIAL_SIGMA_M=0
ENV RL_INSERT_HANDOFF_ROT_SIGMA_RAD=0
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp
ENV ZENOH_ROUTER_CHECK_ATTEMPTS=-1
# Flowstate's in-cluster Zenoh router.  Baked in so the container connects even
# when the runtime does not inject AIC_ROUTER_ADDR; overridable at runtime.
ENV AIC_ROUTER_ADDR=zenoh-router.app-intrinsic-base.svc.cluster.local:7447

WORKDIR /ws_aic/src/aic

# Configure Zenoh explicitly instead of relying on peer scouting.  The router
# address is baked above; a runtime AIC_MODEL_ROUTER_ADDR/AIC_ROUTER_ADDR still
# wins.  Password auth is only applied when AIC_ENABLE_ACL is set, matching the
# canonical aic_model entrypoint.  When no router address is available at all,
# fall back to the base image's default rmw_zenoh peer scouting rather than
# exiting, so the lifecycle node always comes up.
COPY --chmod=755 <<"EOF" /entrypoint.sh
#!/bin/bash
set -euo pipefail

export RMW_IMPLEMENTATION=rmw_zenoh_cpp

router_addr="${AIC_MODEL_ROUTER_ADDR:-${AIC_ROUTER_ADDR:-}}"

should_enable_acl() {
  [[ "${AIC_ENABLE_ACL:-}" == "true" || "${AIC_ENABLE_ACL:-}" == "1" ]]
}

if [[ -z "$router_addr" ]]; then
  echo "No router address (AIC_MODEL_ROUTER_ADDR/AIC_ROUTER_ADDR) set; falling back to rmw_zenoh peer scouting"
else
  zenoh_override="connect/endpoints=[\"tcp/${router_addr}\"];transport/shared_memory/enabled=false"
  if should_enable_acl; then
    if [[ -z "${AIC_MODEL_PASSWD:-}" ]]; then
      echo "AIC_MODEL_PASSWD must be provided when AIC_ENABLE_ACL is set"
      exit 1
    fi
    printf 'model:%s\n' "$AIC_MODEL_PASSWD" > /credentials.txt
    zenoh_override+=";transport/auth/usrpwd/user=\"model\";transport/auth/usrpwd/password=\"${AIC_MODEL_PASSWD}\";transport/auth/usrpwd/dictionary_file=\"/credentials.txt\""
  fi
  export ZENOH_CONFIG_OVERRIDE="$zenoh_override"
  echo "ZENOH_CONFIG_OVERRIDE=$ZENOH_CONFIG_OVERRIDE"
fi

exec pixi run --as-is ros2 run aic_model aic_model "$@"
EOF

ENTRYPOINT ["/entrypoint.sh"]

# The Flowstate asset name may vary, but the ROS lifecycle node remains
# aic_model as required by the AIC process wiring.
CMD ["--ros-args", "-p", "policy:=aic_model.RLInsert", "-p", "use_sim_time:=true"]
