<?xml version="1.0" ?>
<!--
Ground-truth NIC Card Mount SDF from Intrinsic GitHub (saved 2026-07-13).
Reference only; the RL sim (RL/scene_env.py) uses a CALIBRATED MuJoCo abstraction
of this geometry, not a direct port. Key facts used by the seat RL:

  * seated_depth: sfp_port_X_link_entrance is at z=-0.0458 relative to
    sfp_port_X_link  => 45.8 mm mouth->seated. Matches cfg.seated_depth_m.
  * port spacing: port_0 local x=+0.01295, port_1 local x=-0.01025 => 23.2 mm
    apart (this is the neighbor-port gap behind the parked "wrong port" pick).
  * real contact fingers: contact_collision_01/_02 are thin (0.25 mm) boxes at
    x=+0.012963 / -0.010237, z~+0.00285, tilt 3.128 rad -- the SFP cage fingers
    the tip latches into (one per port). Holders sit 2 mm higher (z=0.008).
  * friction: 0.1 everywhere (Gazebo bullet). NOTE: the MuJoCo ridge uses
    friction 5.0 by CALIBRATION (friction 2.0 caused excessive lateral slip);
    do NOT naively copy 0.1 -- it is a different contact model.
  * calibrated MuJoCo ridge sits at 6.0-7.5 mm insertion depth
    (cfg.compiled_contact_ridge_depth_range_m), which matches the script's
    ~5-6 mm stall and this SDF's mouth-region geometry.
-->
<sdf version="1.9">
  <model name="NIC Card Mount 0">
    <static>true</static>

    <link name="nic_card_mount_link">
      <visual name="nic_card_mount_visual">
        <geometry>
          <mesh>
            <uri>nic_card_mount_visual.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="v1015085006_collider_box">
        <pose>0.006002 -0.025497 0.0875 0.0 0.0 1.570796</pose>
        <geometry>
          <box>
            <size>0.005007 0.073996 0.155</size>
          </box>
        </geometry>
      </collision>
      <collision name="v1015085006_collider_box.001">
        <pose>-0.0555 -0.0155 0.172 0.0 0.0 1.570796</pose>
        <geometry>
          <box>
            <size>0.025 0.0215 0.014</size>
          </box>
        </geometry>
      </collision>
      <collision name="v1015085006_collider_box.002">
        <pose>0.038535 -0.01425 0.1155 0.0 0.0 1.570796</pose>
        <geometry>
          <box>
            <size>0.0275 0.005064 0.103</size>
          </box>
        </geometry>
      </collision>
      <collision name="v1015085006_collider_box.003">
        <pose>-0.001997 -0.017997 0.0075 0.0 0.0 1.570796</pose>
        <geometry>
          <box>
            <size>0.020006 0.089788 0.015</size>
          </box>
        </geometry>
      </collision>
      <collision name="v1015085006_collider_box004_collider_box">
        <pose>-0.042132 -0.025499 0.151803 0.785 0.0 1.570796</pose>
        <geometry>
          <box>
            <size>0.005001 0.0515 0.015</size>
          </box>
        </geometry>
      </collision>
      <collision name="v1015085006_collider_box.005">
        <pose>-0.043 -0.0198 0.1665 0.78 0.0 1.570796</pose>
        <geometry>
          <box>
            <size>0.016 0.02 0.015</size>
          </box>
        </geometry>
      </collision>
      <collision name="v1015085011_collider_box">
        <pose>3e-06 -0.004871 0.0025 0.0 -0.0 1.570796</pose>
        <geometry>
          <box>
            <size>0.015669 0.062 0.005</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="nic_card_link">
      <pose>-0.002 -0.01785 0.0899 -1.57 0 0</pose>
      <inertial auto="true">
        <mass>0.15</mass>
      </inertial>
      <visual name="nic_card_visual">
        <geometry>
          <mesh>
            <uri>nic_card_visual.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="pcb_collider_box">
        <pose>0.0 0.0 -0.0008 0.0 0.0 0.0</pose>
        <geometry>
          <box>
            <size>0.056 0.145 0.0016</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <torsional>
              <coefficient>0.1</coefficient>
            </torsional>
            <bullet>
              <friction>0.1</friction>
              <friction2>0.1</friction2>
              <rolling_friction>0.1</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
      <collision name="contact_collision_01">
        <pose>0.012963 -0.0305 0.002845 3.128092 0.0 0.0</pose>
        <geometry>
          <box>
            <size>0.008112 0.00025 0.0025</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <torsional>
              <coefficient>0.1</coefficient>
            </torsional>
            <bullet>
              <friction>0.1</friction>
              <friction2>0.1</friction2>
              <rolling_friction>0.1</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
      <collision name="contact_collision_02">
        <pose>-0.010237 -0.0305 0.002845 3.128092 0.0 0.0</pose>
        <geometry>
          <box>
            <size>0.008112 0.00025 0.0025</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <torsional>
              <coefficient>0.1</coefficient>
            </torsional>
            <bullet>
              <friction>0.1</friction>
              <friction2>0.1</friction2>
              <rolling_friction>0.1</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="card_joint" type="fixed">
      <parent>nic_card_mount_link</parent>
      <child>nic_card_link</child>
    </joint>

    <link name="sfp_port_0_link">
      <pose relative_to="nic_card_link">0.01295 -0.031572 0.00501 4.69895 0 0</pose>
    </link>
    <link name="sfp_port_0_link_entrance">
      <pose relative_to="sfp_port_0_link">0 0 -0.0458 0 0 0</pose>
    </link>
    <joint name="sfp_port_0_joint" type="fixed">
      <parent>nic_card_link</parent>
      <child>sfp_port_0_link</child>
    </joint>
    <joint name="sfp_port_0_entrance_joint" type="fixed">
      <parent>sfp_port_0_link</parent>
      <child>sfp_port_0_link_entrance</child>
    </joint>

    <link name="sfp_port_1_link">
      <pose relative_to="nic_card_link">-0.01025 -0.031572 0.00501 4.69895 0 0</pose>
    </link>
    <link name="sfp_port_1_link_entrance">
      <pose relative_to="sfp_port_1_link">0 0 -0.0458 0 0 0</pose>
    </link>
    <joint name="sfp_port_1_joint" type="fixed">
      <parent>nic_card_link</parent>
      <child>sfp_port_1_link</child>
    </joint>
    <joint name="sfp_port_1_entrance_joint" type="fixed">
      <parent>sfp_port_1_link</parent>
      <child>sfp_port_1_link_entrance</child>
    </joint>
  </model>
</sdf>
